# Copy this file to .env. Never commit .env or put keys in HTML/JS.
# The base must include /v1; example local Dify API:
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
# Published Workflow: start text variable -> request_json, end output -> result.
DIFY_INPUT_KEY=request_json
DIFY_OUTPUT_KEY=result
